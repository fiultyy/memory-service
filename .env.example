# mem-service 配置 — 复制为 .env 填实际值 (.env 不进 git, 见 .gitignore)
# cli.py 启动时自动加载同目录 .env (setdefault: 不覆盖已存在的 env)

# ── LLM (蝴蝶翼抽取, Zhipu Anthropic 协议) ──
MEM_LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
MEM_LLM_MODEL=glm-5-turbo
ZHIPU_API_KEY=              # 必填; cli 从本 .env 加载 (不进 git)

# ── Embedding (向量召回, local OpenAI-compat; 都不可用则 recall 降级字面/centrality/LIF) ──
MEM_LMSTUDIO_URL=http://127.0.0.1:16666
MEM_LMSTUDIO_MODEL=text-embedding-qwen3-embedding-4b
MEM_OLLAMA_URL=http://127.0.0.1:11434
MEM_OLLAMA_MODEL=qwen3-embedding:4b

# ── mem_score (ADR-15 投影排序标量 = LIF + confidence 关联) ──
# confidence 落 KG 后静态(不随 consolidate 更新)→ v1 LIF 主导。TODO 债务: consolidation 刷新 confidence。
MEM_MEMSCORE_MODE=weighted        # weighted(默认) | harmonic | lif
MEM_MEMSCORE_W_LIF=0.7            # weighted 模式 LIF 权重
MEM_MEMSCORE_W_CONF=0.3           # weighted 模式 confidence 权重
