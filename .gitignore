# 运行时产物 (cli 跑时自建)
data/
__pycache__/
*.pyc
.pytest_cache/
*.bak*
*.db
*.db-wal
*.db-shm
logs/

# codebase-memory MCP 索引产物 (index_repository 可重建)
.codebase-memory/

# 环境变量 (含 API key, 不进 git; .env.example 是模板)
.env

# orchestrator 运行时编排 state (不版本化)
.claude/orchestrator-state.json
.claude/orchestrator-state.lock

# orchestrator P2/P3 过程产物 (workflow 脚本/p3 json/tickets, 可重建不版本化)
.claude/orchestrator-workflow-*.js
.claude/orchestrator-p3-*.json
.claude/orchestrator-graph-reingest.json
.scratch/

# 研究笔记 (本地草稿, 不版本化)
docs/research/

# 测试样本目录 (如 openclaw claw-02 init 样本) — 本地测试数据不入库
temp/
